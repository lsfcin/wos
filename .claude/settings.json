{
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/statusline.py"
  },
  "permissions": {
    "allow": [
      "Bash(git -C * log *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * status)",
      "Bash(git -C * show *)",
      "Bash(git -C * branch *)",
      "Bash(codegraph sync *)",
      "Bash(codegraph explore *)",
      "Bash(codegraph query *)",
      "Bash(codegraph callers *)",
      "Bash(codegraph node *)",
      "Bash(codegraph status *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/dispatch.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/read/agent-context.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/core/hooks/post-edit.sh"
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/dispatch.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/context-meter.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/notify.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/precompact-wipe.py"
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/notify.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/session-prune.py"
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/git/branch_marker.py record"
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/mirror-heal.py"
          },
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/session/nudges.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PROJECT_DIR}/core/run hooks/read/agent-context.py"
          }
        ]
      }
    ]
  }
}