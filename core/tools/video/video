# Usage: core/tools/video/video <url>... | --from <file> [--level auto|meta|captions|speech|ocr|visual|full] [--save] [--json] — extract navigable text (metadata/captions/transcript/OCR/VLM caption) from video/image links; a link with no media falls back to core/tools/web/fetch
#
# Takes MANY urls on purpose. One link per invocation made a link-heavy INBOX drain N
# invocations, and a step that costs N decisions is the step that gets skipped — see
# core/tools/SPECS.md § A step an agent must never skip has to cost one call.
import sys, json, re, pathlib, subprocess
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))  # tools root
import tool_law  # noqa: E402
from video_core import assemble

USAGE = ("Usage: core/tools/video/video <url>... | --from <file> "
         "[--level auto|meta|captions|speech|ocr|visual|full] [--save] [--json]")
FETCH = pathlib.Path(__file__).resolve().parents[1] / "web" / "fetch"
# ) and ] are excluded so a markdown link yields the url, not the closing bracket.
URL_RE = re.compile(r'https?://[^\s<>"\'()\[\]]+')
TRAILING = '.,;:!?*_`'


def urls_from_text(text):
    """Every url in a blob of prose, in order, without duplicates."""
    seen, out = set(), []
    for hit in URL_RE.findall(text):
        url = hit.rstrip(TRAILING)
        if url and url not in seen:
            seen.add(url)
            out.append(url)
    return out


def web_fetch(url):
    """The non-media path: read the page as text through the web family's tool."""
    r = subprocess.run([str(FETCH), url], capture_output=True, text=True, timeout=120, encoding='utf-8')
    return r.stdout.strip()


def extract_one(url, level="auto", save=False, _assemble=None, _fetch=None):
    """One bundle for one url. Never raises: a failure is a bundle with ok=False."""
    try:
        b = (_assemble or assemble)(url, level=level, save=save)
    except Exception as e:                                    # noqa: BLE001 - isolate the link
        b = {"url": url, "source": url, "ok": False, "method": "none",
             "text": "", "error": f"{type(e).__name__}: {e}"}
    b.setdefault("url", url)
    if (b.get("text") or "").strip():
        return b
    try:
        text = (_fetch or web_fetch)(url)
    except Exception as e:                                    # noqa: BLE001 - same
        b.setdefault("error", f"{type(e).__name__}: {e}")
        return b
    if text:
        b.update(text=text, method="web/fetch", ok=True)
        b.pop("error", None)
    return b


def run_batch(urls, level="auto", save=False, _assemble=None, _fetch=None):
    """One bundle per url. A failing link never stops the ones behind it."""
    return [extract_one(u, level, save, _assemble, _fetch) for u in urls]


def print_block(b, idx=None, total=None):
    head = f"# {b.get('title') or b['url']}  ({b.get('method')})"
    if idx is not None:
        print(f"\n--- [{idx}/{total}] {b['url']}")
    print(head)
    if b.get("uploader"):
        print(f"by {b['uploader']}")
    if not b.get("ok"):
        print(f"[incomplete: {b.get('error')}]", file=sys.stderr)
    print()
    print(b.get("text") or "(no text extracted)")
    if b.get("saved_path"):
        print(f"\n[saved: {b['saved_path']}]", file=sys.stderr)


def parse_args(args):
    """-> (urls, level, save, as_json). Raises ValueError with a message on misuse."""
    urls, level, save, as_json, src = [], "auto", False, False, None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--level", "--from") and i + 1 < len(args):
            if a == "--level":
                level = args[i + 1]
            else:
                src = args[i + 1]
            i += 2
            continue
        if a == "--save":
            save = True
        elif a == "--json":
            as_json = True
        elif a.startswith("-"):
            raise ValueError(f"unknown option: {a}")
        else:
            urls.append(a)
        i += 1
    if src:
        path = pathlib.Path(src)
        if not path.exists():
            raise ValueError(f"no such file: {src}")
        urls = urls_from_text(path.read_text(encoding='utf-8')) + urls
    if level == "meta":
        level = "metadata"
    return urls, level, save, as_json


def main(argv=None):
    tool_law.require('video-text')  # before argparse: off means off, including --help
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help"):
        print(USAGE, file=sys.stderr)
        return 1
    try:
        urls, level, save, as_json = parse_args(args)
    except ValueError as e:
        print(f"{e}\n{USAGE}", file=sys.stderr)
        return 1
    if not urls:
        print("no links found — nothing to extract", file=sys.stderr)
        return 0

    bundles = run_batch(urls, level=level, save=save)
    if as_json:
        print(json.dumps(bundles, ensure_ascii=False, indent=2))
        return 0
    single = len(bundles) == 1
    for i, b in enumerate(bundles, 1):
        print_block(b, None if single else i, len(bundles))
    if not single:
        ok = sum(1 for b in bundles if b.get("ok"))
        print(f"\n{len(bundles)} links · {ok} ok · {len(bundles) - ok} failed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
