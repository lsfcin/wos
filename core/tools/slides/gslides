# Usage: core/tools/slides/gslides <cmd> [args] — Google Slides CLI: auth, list, read, new, add, text, apply, preview, export, sample
import sys, json, pathlib, argparse

_HERE = pathlib.Path(__file__).resolve().parent
# Boundaries sit beside the CLI; gauth and gcli are shared, one hop up.
sys.path.insert(0, str(_HERE))
sys.path.insert(0, str(_HERE.parent))
sys.path.insert(0, str(_HERE.parent / 'auth'))
import slides_core, slides_outline, deck_sample, gauth, gcli, short_name as short_name_tool


def cmd_auth(alias: str, write: bool, reauth: bool) -> None:
    kind = "slides-write" if write else "slides"
    gcli.auth_command(kind, alias, lambda a: slides_core.get_service(a, write=write), reauth)


def cmd_list(account: str, name: str) -> None:
    for alias in gcli.aliases(account):
        print(f"\n── Presentations ({alias}) ──")
        found = slides_core.list_presentations(alias, name)
        if not found:
            print("  (nenhuma apresentação)")
        for f in found:
            print(f"  [{alias}] {f['name']}  ({f.get('modifiedTime', '')[:10]})  id:{f['id']}")


def cmd_read(account: str, presentation_id: str, as_json: bool, verbose: bool) -> None:
    alias = gauth.resolve_alias(account)
    pres = slides_core.get_presentation(alias, presentation_id)
    print(json.dumps(pres, ensure_ascii=False, indent=2) if as_json
          else slides_outline.outline(pres, verbose=verbose))


def cmd_new(account: str, title: str, short_name: str) -> None:
    alias = gauth.resolve_alias(account)
    pres = slides_core.create(alias, title)
    print(f"Created '{pres['title']}' ({alias})  id:{pres['presentationId']}")
    print(f"  {slides_core.url(pres['presentationId'])}")
    if short_name:
        print(short_name_tool.mint(short_name, slides_core.url(pres['presentationId'])))


def cmd_add(account: str, presentation_id: str, layout: str) -> None:
    alias = gauth.resolve_alias(account)
    res = slides_core.apply(alias, presentation_id, [
        {"createSlide": {"slideLayoutReference": {"predefinedLayout": layout}}}
    ])
    new_id = res["replies"][0]["createSlide"]["objectId"]
    print(f"Added slide [{new_id}] ({layout})")
    print(f"  {slides_core.url(presentation_id)}")


def cmd_text(account: str, presentation_id: str, slide_id: str, text: str,
             x: float, y: float, w: float, h: float) -> None:
    alias = gauth.resolve_alias(account)
    object_id = f"wos_{abs(hash((slide_id, text))) % 10**10}"
    slides_core.apply(alias, presentation_id,
                      slides_core.textbox(object_id, slide_id, text, x, y, w, h))
    print(f"Wrote text box [{object_id}] on slide {slide_id}")
    print(f"  {slides_core.url(presentation_id)}")


def cmd_apply(account: str, presentation_id: str, path: str) -> None:
    """The general boundary: a JSON array of Slides API requests, applied atomically."""
    alias = gauth.resolve_alias(account)
    requests = json.loads(pathlib.Path(path).read_text(encoding='utf-8'))
    res = slides_core.apply(alias, presentation_id, requests)
    print(f"Applied {len(requests)} request(s); {len(res.get('replies', []))} replies")
    print(f"  {slides_core.url(presentation_id)}")


def cmd_preview(account: str, presentation_id: str, out_dir: str) -> None:
    """Download PNG thumbnails for every slide to empower visual inspection."""
    import urllib.request
    alias = gauth.resolve_alias(account)
    deck = slides_core.get_presentation(alias, presentation_id)
    slides = deck.get("slides", [])
    target = pathlib.Path(out_dir) if out_dir else pathlib.Path.cwd() / f"previews_{presentation_id}"
    target.mkdir(parents=True, exist_ok=True)
    print(f"Generating previews for {len(slides)} slides into {target}...")
    for idx, s in enumerate(slides, 1):
        sid = s["objectId"]
        url = slides_core.get_thumbnail_url(alias, presentation_id, sid)
        if url:
            dest = target / f"slide_{idx:02d}_{sid}.png"
            urllib.request.urlretrieve(url, dest)
            print(f"  [{idx:02d}/{len(slides):02d}] {dest.name}")
    print(f"Done. Saved to: {target}")


def cmd_export(target: str, fmt: str, out_path: str) -> None:
    """Download Google Slides deck via public export endpoint (fallback without OAuth)."""
    parsed = deck_sample.parse_slide_target(target)
    if parsed["kind"] != "google_slides":
        print(f"Error: target '{target}' is not a Google Slides ID or URL.", file=sys.stderr)
        sys.exit(1)
    dest = pathlib.Path(out_path) if out_path else pathlib.Path.cwd() / f"{parsed['id']}.{fmt}"
    print(f"Exporting presentation {parsed['id']} as {fmt.upper()} to {dest}...")
    deck_sample.download_public_export(parsed["id"], dest, format=fmt)
    print(f"Done. Saved to: {dest}")


def cmd_sample(target: str, out_dir: str, dpi: int, max_samples: int) -> None:
    """Ingest deck, cluster animation sequences and render keyframe thumbnails."""
    dest = pathlib.Path(out_dir) if out_dir else None
    deck_sample.sample_deck(target, out_dir=dest, dpi=dpi, max_samples=max_samples)


def main():
    p = argparse.ArgumentParser(prog="gslides")
    sub = p.add_subparsers(dest="cmd")

    pa = sub.add_parser("auth")
    pa.add_argument("alias")
    pa.add_argument("--write", action="store_true", help="request edit scope (slides-write token)")
    pa.add_argument("--reauth", action="store_true", help="drop the existing token and re-consent (fixes revoked/expired)")

    pl = sub.add_parser("list")
    pl.add_argument("--account", default="all")
    pl.add_argument("--name", default="", help="filter by name substring")

    pr = sub.add_parser("read")
    pr.add_argument("--account", required=True)
    pr.add_argument("--json", dest="as_json", action="store_true", help="raw API JSON instead of the outline")
    pr.add_argument("--verbose", action="store_true", help="include elements that carry no text")
    pr.add_argument("presentation_id")

    pn = sub.add_parser("new")
    pn.add_argument("--account", required=True)
    pn.add_argument("--short-name", default="", help="also mint a short link for the new deck")
    pn.add_argument("title")

    pad = sub.add_parser("add")
    pad.add_argument("--account", required=True)
    pad.add_argument("--layout", default="BLANK")
    pad.add_argument("presentation_id")

    pt = sub.add_parser("text")
    pt.add_argument("--account", required=True)
    pt.add_argument("--slide", required=True, dest="slide_id")
    pt.add_argument("--x", type=float, default=0.1)
    pt.add_argument("--y", type=float, default=0.1)
    pt.add_argument("--w", type=float, default=0.8)
    pt.add_argument("--h", type=float, default=0.15)
    pt.add_argument("presentation_id")
    pt.add_argument("text")

    pap = sub.add_parser("apply")
    pap.add_argument("--account", required=True)
    pap.add_argument("presentation_id")
    pap.add_argument("requests_json", help="file holding a JSON array of Slides API requests")

    ppr = sub.add_parser("preview")
    ppr.add_argument("--account", required=True)
    ppr.add_argument("--out", dest="out_dir", default="", help="destination directory for PNGs")
    ppr.add_argument("presentation_id")

    pex = sub.add_parser("export", help="download presentation as PDF or PPTX without requiring OAuth")
    pex.add_argument("target", help="Google Slides URL or presentation ID")
    pex.add_argument("--format", default="pdf", choices=["pdf", "pptx"], help="export format (default: pdf)")
    pex.add_argument("--out", dest="out_path", default="", help="output destination file path")

    psm = sub.add_parser("sample", help="sample key slides, cluster animations and generate visual thumbnails")
    psm.add_argument("target", help="Google Slides URL/ID or local PDF file")
    psm.add_argument("--out", dest="out_dir", default="", help="output directory for manifest and thumbnails")
    psm.add_argument("--dpi", type=int, default=150, help="rendering DPI for thumbnails (default: 150)")
    psm.add_argument("--max-samples", type=int, default=25, help="maximum number of key slides to sample (default: 25)")

    args = p.parse_args()
    if   args.cmd == "auth":    cmd_auth(args.alias, args.write, args.reauth)
    elif args.cmd == "list":    cmd_list(args.account, args.name)
    elif args.cmd == "read":    cmd_read(args.account, args.presentation_id, args.as_json, args.verbose)
    elif args.cmd == "new":     cmd_new(args.account, args.title, args.short_name)
    elif args.cmd == "add":     cmd_add(args.account, args.presentation_id, args.layout)
    elif args.cmd == "text":    cmd_text(args.account, args.presentation_id, args.slide_id,
                                         args.text, args.x, args.y, args.w, args.h)
    elif args.cmd == "apply":   cmd_apply(args.account, args.presentation_id, args.requests_json)
    elif args.cmd == "preview": cmd_preview(args.account, args.presentation_id, args.out_dir)
    elif args.cmd == "export":  cmd_export(args.target, args.format, args.out_path)
    elif args.cmd == "sample":  cmd_sample(args.target, args.out_dir, args.dpi, args.max_samples)
    else:                       p.print_help()



if __name__ == "__main__":
    gauth.run(main)
