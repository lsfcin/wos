# Usage: core/run tools/wos/publish/repo [--orphans] [--check] [--sync] [--push] — what crosses into the public repo, what no feature claims, and whether anything crossing carries a credential
#
# THE SECRET GATE RUNS HERE AND NOWHERE ELSE, and that is a decision rather than an omission. Once
# a credential is in the target's working tree it is one `git add -A` from being permanent, so the
# only moment a refusal still works is before the copy. A second copy at commit time would guard
# against hand-edits in the target, and hand-edits in the target are already forbidden: the sync is
# one-way and rebuilds the target from this side. Do not add the second gate.
#
# SYNC AND PUSH ARE SEPARATE FLAGS so the target is always inspectable before anything leaves the
# machine. `--sync` is reversible — it rebuilds a working tree this side already holds. `--push` is
# not, and it is the only step here that is Lucas's call rather than the tool's.
from __future__ import annotations
import argparse, datetime, pathlib, re, shutil, subprocess, sys

_HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE))
sys.path.insert(0, str(_HERE.parents[1]))
import tool_law  # noqa: E402
import secret_law  # noqa: E402
import crossing as core  # noqa: E402
import rebuild  # noqa: E402


def _lines(paths) -> int:
    total = 0
    for path in paths:
        try:
            total += (core.ROOT / path).read_text(encoding='utf-8').count('\n')
        except (OSError, UnicodeDecodeError):
            pass
    return total


def show(rep: core.Report, floor: core.Floor) -> None:
    print(f'target  {floor.target.relative_to(core.ROOT)}'
          f'{"" if floor.target.exists() else "   (not checked out)"}')
    print(f'crossing  {len(rep.crossing)} files · {_lines(rep.crossing):,} lines'
          f'  ·  claimed by {len(rep.by_feature)} features')
    print(f'orphans   {len(rep.orphans)} files · {_lines(rep.orphans):,} lines'
          '  — eligible and tracked, claimed by nobody')
    for path, name in rep.unclaimed_imports:
        print(f'  ESCAPES  {path} imports {name}, which the floor refuses')


def check(rep: core.Report) -> int:
    findings = secret_law.scan_all([core.ROOT / p for p in sorted(rep.crossing)])
    if not findings:
        print(f'secret gate: clean over {len(rep.crossing)} crossing files')
        return 0
    print(f'secret gate: {len(findings)} finding(s) — REFUSING')
    for finding in findings:
        print(f'  {finding}')
    return 1


# What the TARGET authors, and the sync never touches: the two lists the 2026-09-04 per-repo ruling
# says each repo keeps for itself, and the ignore file this tool generates for it below.
SELF = ('ROADMAP.md', 'ISSUES.md', '.gitignore')

IGNORE_HEAD = """\
# Generated by core/run tools/wos/publish/repo in the workspace this repo is synced FROM. Do not
# edit here: the sync is one way and rebuilds this tree from that side.
#
# It is also what the sync will not DELETE. A path ignored here is written by a generator in this
# repo — the skill mirrors, the venv, the scoreboard — and the sync deleting it as unclaimed while
# the generator put it back is a loop, not a cleanup.
.venv/
__pycache__/
.pytest_cache/
outputs/
core/scoreboard.tsv
core/profile.local.txt
.claude/skills/*/
.claude/commands/*.md
.opencode/skills/*/
.zcode/skills/*/
.zcode/skills/CONTEXT.md
.zcode/plans/
.agents/skills/*/

# Below: prose in a file that crossed, pointing at a file that did not. Naming them as deliberately
# absent keeps the pointer check green here without rewriting a line of the text upstream —
# test_pointer_integrity asks `git check-ignore` in the repo being checked.
"""


# A GENERATED BLOCK IS THE TARGET'S, not the sync's. AGENTS.md crosses whole and its routing table
# is rewritten in the target by the same generator that wrote it here — correctly, because the
# public tree has one subdirectory and this one has six. Comparing those bytes makes the file STALE
# forever and the sync copy it back every run, which is an oscillation rather than a difference.
#
# IGNORING A BLOCK IS ONLY SAFE WHILE SOMETHING REWRITES IT THERE, and until 2026-09-17 nothing did:
# push() used --no-verify, so no generator ever ran in the target, and 34 pointers inside a block
# aimed at files the floor refuses. That is why sync() now calls rebuild — this regex says a block is
# NOT COMPARED, and rebuild.py is what earns the right to say it.
_BLOCK = re.compile(rb'<!-- \w+:start -->.*?<!-- \w+:end -->', re.S)


def _same(source: pathlib.Path, destination: pathlib.Path) -> bool:
    left, right = source.read_bytes(), destination.read_bytes()
    return left == right or _BLOCK.sub(b'', left) == _BLOCK.sub(b'', right)


def _present(target: pathlib.Path) -> set[str]:
    """What the target holds that the sync owns. The target's own `.gitignore` — written above —
    answers the rest, and asking git rather than re-deriving it keeps one answer in one place, the
    same reason `tracked()` asks git on this side."""
    found = {p.relative_to(target).as_posix() for p in target.rglob('*')
             if p.is_file() and '.git' not in p.relative_to(target).parts}
    ignored = subprocess.run(['git', '-C', str(target), 'check-ignore', '--stdin'],
                             input='\n'.join(found), capture_output=True, text=True,
                             encoding='utf-8').stdout.split('\n')
    return found - set(ignored) - set(SELF)


def sync(rep: core.Report, floor: core.Floor, act: bool) -> int:
    if not floor.target.is_dir():
        print(f'target {floor.target} is not checked out')
        return 1
    if act and check(rep):   # refuse before the first byte, never redact after it
        return 1
    if act:   # first, because it is what decides which of the target's files the sync owns at all
        # The orphans belong here beside the floor's refusals, and for the same reason: a file no
        # feature claims is deliberately absent, not missing. Prose that crossed still points at
        # some of them, and this is what lets the pointer check agree without editing that prose.
        # SELF is subtracted: ROADMAP.md and ISSUES.md are absent FROM THE SYNC and present in the
        # target, which writes its own. Listing them here ignored the target's copies, and a repo
        # whose ISSUES.md git does not carry cannot run the gate that watches writes to it.
        absent = sorted((set(floor.absent) | rep.orphans) - set(SELF))
        # A refusal holding something let back out is written as its CONTENTS plus the exception,
        # because git will not re-include a file whose parent directory is excluded: `/code` would
        # have made every aiwbot file the sync just wrote invisible to the target's own git.
        # EVERY KIND THAT ESCAPES NEEDS ITS EXCEPTION, not just `root`. This read `floor.roots`
        # alone until 2026-09-17, so the first `file` let out of an absent tree stayed ignored in
        # the target: `_present` asks the target's git, git said code/CONTEXT.md was not there, and
        # every run recopied it as MISSING. An oscillation, and one no verdict named as such.
        lines = []
        for path in absent:
            dirs = sorted(r for r in floor.roots + floor.trees if r.startswith(path + '/'))
            files = sorted(r for r in floor.files if r.startswith(path + '/'))
            lines.append(f'/{path}/*\n' if dirs or files else f'/{path}\n')
            lines += [f'!/{r}/\n' for r in dirs] + [f'!/{r}\n' for r in files]
        (floor.target / '.gitignore').write_text(
            IGNORE_HEAD + ''.join(lines), encoding='utf-8', newline='\n')
    present, verdicts = _present(floor.target), []
    for name in sorted(rep.crossing):
        source, destination = core.ROOT / name, floor.target / name
        if name not in present:
            verdicts.append(('MISSING', name))
        elif not _same(source, destination):
            verdicts.append(('STALE', name))
        else:
            continue
        if act:
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)
    for name in sorted(present - rep.crossing):
        verdicts.append(('ORPHAN', name))
        if act:
            (floor.target / name).unlink()
    failed = []
    if act:
        _modes(floor, rep.crossing)
        # LAST, and only on a real sync: the generators read the tree the copy just finished
        # writing, and running them over a half-copied tree would publish a table of it.
        failed = rebuild.generators(floor.target)
    for verdict, name in verdicts + [('FAILED', line) for line in failed]:
        print(f'  {verdict:8} {name}')
    print(f'{"synced" if act else "check"}: {len(verdicts)} difference(s) over '
          f'{len(rep.crossing)} crossing files')
    if failed:
        return 1
    return 0 if act else (1 if verdicts else 0)


def _modes(floor: core.Floor, names: set[str]) -> None:
    """Carry the executable bit through the INDEX, not the filesystem. A working tree on a mount
    that reports 777 for everything says nothing, and what a clone gets is the index: core/run
    landed 100644 in the target, so the one command that runs everything could not be run."""
    source = subprocess.run(['git', '-C', str(core.ROOT), 'ls-files', '-s'],
                            capture_output=True, text=True, encoding='utf-8', check=True)
    runnable = [line.split('\t', 1)[1] for line in source.stdout.split('\n')
                if line.startswith('100755\t') or line.startswith('100755 ')]
    wanted = [n for n in runnable if n in names]
    if wanted:
        subprocess.run(['git', '-C', str(floor.target), 'update-index', '--add', '--chmod=+x',
                        *wanted], check=True)


# THE SYNC COMMITS UNDER THE SAME GIT FLOW AS EVERY OTHER REPO UNDER code/, and no longer bypasses
# it. `--no-verify` was here because gitflow_gate covers any repo under code/ — this target included
# — and the target sits on `master`, so a direct commit is refused. The bypass bought that refusal
# off and took the WHOLE pre-commit pipeline with it: the generators, the gates, and the target's own
# verify suite, which is the one thing that has ever caught a defect invisible from this side. So the
# branch is made instead of the gate being dodged, and the two merges land by --no-ff, which is the
# MERGE_HEAD exit gitflow_gate already grants the sanctioned integration step.
FLOW = ('develop', 'master')


def push(floor: core.Floor) -> int:
    git = ['git', '-C', str(floor.target)]
    subprocess.run(git + ['add', '-A'], check=True)
    if not subprocess.run(git + ['diff', '--cached', '--quiet']).returncode:
        print('nothing to push: the target already matches')
        return 0
    branch = f'feature/sync-{datetime.datetime.now():%Y%m%d-%H%M}'
    subprocess.run(git + ['checkout', '-b', branch], check=True)
    # NOT check=True, and NOT --no-verify: a refusal here is the target's own pipeline saying the
    # sync produced something it will not carry, which is the signal this call exists to surface.
    if subprocess.run(git + ['commit', '-m',
                             'sync: rebuilt from the workspace this repo is synced from']).returncode:
        print(f'⛔ the target refused the commit on {branch}. Nothing was pushed; read the gate '
              'above, fix it HERE, and re-run --sync --push. The branch is left in place.')
        return 1
    for into in FLOW:
        subprocess.run(git + ['checkout', into], check=True)
        subprocess.run(git + ['merge', '--no-ff', '-m', f'sync: merge {branch}', branch], check=True)
    subprocess.run(git + ['push', 'origin', *FLOW], check=True)
    subprocess.run(git + ['branch', '-d', branch], check=True)
    return 0


def main() -> int:
    tool_law.require('publish')  # before argparse: off means off, including --help
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument('--orphans', action='store_true',
                    help='list every eligible tracked file no feature claims')
    ap.add_argument('--check', action='store_true',
                    help='exit 1 on a credential in the crossing set, or on target disagreement')
    ap.add_argument('--sync', action='store_true',
                    help='make the target match; refuses before the first byte on a credential')
    ap.add_argument('--push', action='store_true',
                    help='commit and push the target. The one step that leaves the machine')
    args = ap.parse_args()
    rep, floor = core.report(), core.floor()
    if args.orphans:
        for path in sorted(rep.orphans):
            print(path)
        return 0
    if args.push:
        return push(floor)
    show(rep, floor)
    if args.sync:
        return sync(rep, floor, act=True)
    return sync(rep, floor, act=False) or check(rep) if args.check else 0


if __name__ == '__main__':
    sys.exit(main())
